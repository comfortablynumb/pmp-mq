# Backend Configuration
BACKEND_TYPE=postgres  # Options: postgres, kafka

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pmp_mq

# Kafka Configuration (only needed if BACKEND_TYPE=kafka)
PMP_MQ__KAFKA__BROKERS=localhost:9092
PMP_MQ__KAFKA__POSTGRES_URL=postgres://postgres:postgres@localhost:5432/pmp_mq
PMP_MQ__KAFKA__MAX_CONNECTIONS=10

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Delivery Worker Configuration
PMP_MQ__DELIVERY__WORKER_INTERVAL_SECS=5
PMP_MQ__DELIVERY__BATCH_SIZE=100
PMP_MQ__DELIVERY__MAX_CONCURRENT_DELIVERIES=50
PMP_MQ__DELIVERY__REQUEST_TIMEOUT_SECS=30

# Logging
RUST_LOG=pmp_mq_server=info,pmp_mq_core=info,pmp_mq_backends=info
